---
import { DateTime } from 'luxon';
import Layout from '../layouts/Layout.astro';
import RecapChapter from '../components/RecapChapter.astro';
import RobotOverlords from '../components/RobotOverlords.astro';
import ScaleMoment from '../components/ScaleMoment.astro';
import CoffeeScale from '../components/CoffeeScale.astro';
import { estimateCaffeine } from '../data/caffeine';
import { loadBuildSnapshot } from '../../scripts/recap/build-input';

const snapshot = await loadBuildSnapshot({ allowDemo: process.env.RECAP_ALLOW_DEMO === '1' });
const timezone = snapshot.timezone;
const cutoff = DateTime.fromISO(snapshot.cutoffExclusive, { setZone: true }).setZone(timezone);
const cutoffLabel = cutoff.toFormat("LLLL d, yyyy 'at' h:mm a ZZZZ");
const collectedLabel = DateTime.fromISO(snapshot.collectedAt, { setZone: true }).setZone(timezone)
  .toFormat("LLLL d, yyyy 'at' h:mm a ZZZZ");
const lastIncludedMonth = cutoff.minus({ milliseconds: 1 }).toFormat('yyyy-MM');
const deploymentMetric = snapshot.metrics.productionDeployments;
const deploymentBreakdown = deploymentMetric.status === 'available'
  ? deploymentMetric.breakdown
    .filter((item) => item.label <= lastIncludedMonth)
    .map((item) => ({
      label: DateTime.fromFormat(item.label, 'yyyy-MM', { zone: timezone }).toFormat('LLLL'),
      count: item.count,
      month: item.label,
    }))
  : [];
const deploymentMonthsOmitted = deploymentMetric.status === 'available'
  && deploymentMetric.breakdown.length > deploymentBreakdown.length;
const positiveDeploymentMonths = deploymentBreakdown.filter((item) => item.count > 0);
const peakCount = positiveDeploymentMonths.length > 0 ? Math.max(...positiveDeploymentMonths.map((item) => item.count)) : null;
const peakMonths = peakCount === null ? [] : positiveDeploymentMonths.filter((item) => item.count === peakCount).map((item) => item.label);
const peakStory = peakCount === null ? null : peakMonths.length > 1
  ? `The calendar gave ${new Intl.ListFormat('en-US', { style: 'long', type: 'conjunction' }).format(peakMonths)} a joint encore: ${peakCount} deployments each.`
  : `${peakMonths[0]} had the loudest shipping drumroll, with ${peakCount} successful deployments.`;
const augustDeployments = deploymentBreakdown.find((item) => item.month === '2026-08')?.count ?? null;
const augustShare = augustDeployments !== null && deploymentMetric.status === 'available'
  && deploymentMetric.count !== null && deploymentMetric.count > 0
  ? Math.round((augustDeployments / deploymentMetric.count) * 100)
  : null;
const workMetric = snapshot.metrics.workItemsClosed;
const bugWorkItems = workMetric.status === 'available'
  ? workMetric.breakdown.find((item) => item.label === 'Bug')?.count ?? null
  : null;
const yearLabel = snapshot.isYearToDate ? `${snapshot.year} so far` : `Calendar year ${snapshot.year}`;
const coverageNote = snapshot.coverage.notes[0];
const playful = snapshot.schemaVersion === 2 ? snapshot.playful : null;
const caffeineEstimate = playful
  ? estimateCaffeine({ periodStart: snapshot.periodStart, cutoffExclusive: snapshot.cutoffExclusive, timezone: snapshot.timezone })
  : null;
const securityChapterIndex = playful ? '04 · The fix-it file' : '01 · The fix-it file';
const deploymentChapterIndex = playful ? '05 · The shipping log' : '02 · The shipping log';
const workChapterIndex = playful ? '06 · The done list' : '03 · The done list';

const dependencyDefinition = 'Dependabot dependency alerts marked fixed during the reporting period. Dismissed alerts are not counted; this is not a count of all security alerts.';
const deploymentDefinition = 'Successful production deployments, grouped by the month of first success.';
const workDefinition = 'Completed work items during the reporting period, excluding epics and canceled or duplicate work.';
---
<Layout
  title="Investments Apps Team Year in Review"
  description={`A playful year in review for the Investments Applications team: ${yearLabel}.`}
  mode={snapshot.mode}
>
  <header class="site-header">
    <div class="site-header__inner">
      <a class="site-name" href="#top" aria-label="Investments Apps Team Year in Review, back to top">
        <span class="site-name__accent" aria-hidden="true"></span>Investments Apps Team Year in Review
      </a>
      <nav class="section-nav" aria-label="Recap sections">
        {playful && <a href="#code-added">Code added</a>}
        {playful && <a href="#code-removed">Code removed</a>}
        {playful && <a href="#robot-overlords">Robot Overlords</a>}
        <a href="#security">Security</a>
        <a href="#deployments">Deployments</a>
        <a href="#work-items">Work items</a>
      </nav>
    </div>
  </header>

  <main id="main-content" class="page-shell" tabindex="-1">
    <div id="top"></div>
    {snapshot.mode === 'demo' && (
      <aside class="notice notice--demo" aria-label="Illustrative data warning">
        <span class="notice__symbol" aria-hidden="true">!</span>
        <p><strong>Illustrative sample · not actual team data</strong>{coverageNote}</p>
      </aside>
    )}

    {playful ? (
      <ScaleMoment yearLabel={yearLabel} linesAdded={playful.linesAdded} linesRemoved={playful.linesRemoved} />
    ) : (
      <section class="v1-intro" aria-labelledby="page-title">
        <p class="eyebrow">Investments Apps Team · {snapshot.year}</p>
        <h1 id="page-title">A year of shared work.<br /><em>{yearLabel}.</em></h1>
        <p>The work we moved forward, one fix, deployment, and completed item at a time.</p>
      </section>
    )}

    {playful && caffeineEstimate && <CoffeeScale estimate={caffeineEstimate} />}

    {snapshot.mode === 'real' && snapshot.coverage.scope === 'accessible-repositories' && (
      <aside class="coverage-note" aria-label="Coverage limitation">
        <strong>Coverage is limited</strong>
        <p>{coverageNote} Not all organization activity may be represented.</p>
      </aside>
    )}

    {playful && <RobotOverlords metrics={playful} />}

    <section class="explore" aria-labelledby="explore-title">
      <div class="explore__heading">
        <h2 id="explore-title">And that’s not the whole story.</h2>
        <p>Three more very different kinds of team activity.</p>
      </div>
      <ul class="chapter-index" aria-label="Recap chapters">
        <li><a href="#security"><small>THE FIX-IT FILE</small><strong>Security clean-up crew</strong><span aria-hidden="true">↗</span></a></li>
        <li><a href="#deployments"><small>THE SHIPPING LOG</small><strong>Deployments, shipshape</strong><span aria-hidden="true">↗</span></a></li>
        <li><a href="#work-items"><small>THE DONE LIST</small><strong>Work in all its shapes</strong><span aria-hidden="true">↗</span></a></li>
      </ul>
    </section>

    <RecapChapter
      id="security"
      index={securityChapterIndex}
      title="Security clean-up crew"
      metricTitle="Dependency alerts fixed"
      definition={dependencyDefinition}
      metric={snapshot.metrics.dependencyAlertsFixed}
      breakdown={snapshot.metrics.dependencyAlertsFixed.breakdown}
    />
    <RecapChapter
      id="deployments"
      index={deploymentChapterIndex}
      title="Deployments, shipshape"
      metricTitle="Successful production deployments"
      definition={deploymentDefinition}
      breakdown={deploymentBreakdown}
      metric={deploymentMetric}
      note={deploymentMonthsOmitted ? 'Months after the reporting cutoff are not shown.' : undefined}
    />
    {deploymentMetric.status === 'available' && (peakStory || augustDeployments !== null) && (
      <aside class="story-note story-note--shipping" aria-label="Deployment notes">
        {peakStory && <p><span aria-hidden="true">✳</span> {peakStory}</p>}
        {augustDeployments !== null && augustShare !== null && (
          <p>August brought {augustDeployments} deployments — {augustShare}% of this year’s {deploymentMetric.count}.</p>
        )}
      </aside>
    )}
    <RecapChapter
      id="work-items"
      index={workChapterIndex}
      title="Work in all its shapes"
      metricTitle="Work items closed"
      definition={workDefinition}
      metric={workMetric}
      breakdown={workMetric.breakdown}
    />
    {bugWorkItems !== null && (
      <aside class="story-note story-note--work" aria-label="Work item note">
        <p><span aria-hidden="true">✳</span> {bugWorkItems} bugs exited the chat.</p>
      </aside>
    )}

    <footer class="site-footer">
      <p>A shared view of the Investments Applications team’s recorded work. Each measure counts a different kind of activity; none is a score.</p>
      <p>Reporting timezone: America/New_York · {snapshot.isYearToDate ? 'Year to date' : `Calendar year ${snapshot.year}`} · The cutoff is exclusive. · Collected: {collectedLabel}</p>
      <p>Reporting cutoff (exclusive): {cutoffLabel}. Source availability is limited to the accessible scope described above.</p>
    </footer>
  </main>
</Layout>
