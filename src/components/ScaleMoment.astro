---
import BookScale from './BookScale.astro';
import type { PlayfulMetrics } from '../data/playful';

interface Props {
  yearLabel: string;
  linesAdded: PlayfulMetrics['linesAdded'];
  linesRemoved: PlayfulMetrics['linesRemoved'];
}

const { yearLabel, linesAdded, linesRemoved } = Astro.props;
const number = (value: number) => new Intl.NumberFormat('en-US').format(value);
const hasAddedLines = linesAdded.status === 'available' && linesAdded.count > 0;
const addedLinesAreZero = linesAdded.status === 'available' && linesAdded.count === 0;
---
<section class="scale-moment" id="code-added" aria-labelledby="page-title">
  <div class="scale-moment__intro">
    <p class="eyebrow">Investments Apps Team · {yearLabel}</p>
    {hasAddedLines ? (
      <>
        <h1 id="page-title">Some code.<br /><em>A surprising number of Slaughterhouse-Fives.</em></h1>
        <p class="scale-moment__description">Listen: the year's added lines, stacked up as copies of <em>Slaughterhouse-Five</em>. Billy Pilgrim would approve. Nothing hidden — the exact total and assumptions are right here. So it goes.</p>
      </>
    ) : addedLinesAreZero ? (
      <>
        <h1 id="page-title">No lines added.<br /><em>No book stack.</em></h1>
        <p class="scale-moment__description">The added-line count is zero, so the printing press stays idle and Slaughterhouse-Five stays on the shelf. The rest of the year still has stories. So it goes.</p>
      </>
    ) : (
      <>
        <h1 id="page-title">The code count<br /><em>is unstuck in time.</em></h1>
        <p class="scale-moment__description">No Slaughterhouse-Five comparison until a complete added-line total is available. The rest of the year still has stories. So it goes.</p>
      </>
    )}
  </div>

  <BookScale linesAdded={linesAdded} />

  <section class="code-removed" id="code-removed" aria-labelledby="code-removed-title">
    <div class="code-removed__label">
      <p class="chapter-label"><span class="chapter-label__number">02</span> &nbsp; THE PLOT TWIST</p>
      <h2 id="code-removed-title">And some lines left the story.</h2>
      <p>Every good story has an edit. These lines took a bow and came unstuck in time. So it goes.</p>
    </div>
    <p class="code-removed__number" data-testid="code-removed-total">
      {linesRemoved.status === 'available' ? number(linesRemoved.count) : 'Not available'}
      <span>lines removed</span>
    </p>
  </section>
</section>
